[Unit]
Description=Finance Digest Bot - servizio Telegram (comandi + coda on-demand)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=amal
WorkingDirectory=/home/amal/progetti/Alfred-Report
Environment=PATH=/home/amal/.nvm/versions/node/v24.19.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/bin
EnvironmentFile=/home/amal/progetti/Alfred-Report/.env
ExecStart=/home/amal/progetti/Alfred-Report/.venv/bin/python bot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
